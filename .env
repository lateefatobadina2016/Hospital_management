# Hospital Management System Configuration

# ===== AI SERVICE CONFIGURATION =====
# Option 1: Use OpenAI (Recommended - Uncomment and add your key)
# OPENAI_API_KEY=sk-your-actual-key-here

# Option 2: Use Groq (Free & Fast - Uncomment and add your key)
# GROQ_API_KEY=your-actual-groq-key-here

# Option 3: Use Ollama (Local - Default, no key needed)
# Make sure Ollama is running: ollama serve
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
